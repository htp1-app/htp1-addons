{
  "id": "airplay",
  "version": "0.2.0",
  "label": "AirPlay",
  "summary": "AirPlay 2 receiver (shairport-sync 4.3.7 with nqptp)",
  "requires": {
    "capabilities": [
      "source/1"
    ]
  },
