[Unit]
Description=Wake-on-play watcher for the UPnP/DLNA renderer
# gmediarender has no session hook, unlike shairport and librespot, so playback
# is detected by watching whether it holds the ALSA device. See upnp-watch.sh.
# PartOf as well as Requires: Requires alone starts upnp with this unit but
# does not stop this unit when upnp stops, which would leave the watcher
# polling for a renderer that is gone after the service is toggled off.
Requires=upnp.service
PartOf=upnp.service
After=upnp.service

[Service]
Type=simple
User=root
# Ordinary scheduling and a low priority: this only polls, it is not in the
# audio path, and it should never compete with the receivers themselves.
Nice=10
ExecStart=/var/lib/olympia/addons/dlna/bin/upnp-watch.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
